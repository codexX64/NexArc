{
  "name": "sentinel-rmm",
  "version": "2.0.0",
  "description": "Supervision et gestion de parc auto-hébergées : agents, tâches distantes, consoles intégrées, réveil réseau.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24.7" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
