#include <winuser.h>
1 RT_MANIFEST "installateur.manifest"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Codex64"
      VALUE "FileDescription", "Sentinel - installation de l'agent"
      VALUE "ProductName", "Sentinel"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "installateur-sentinel.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
