# Sentinel : copier en .env, puis remplir. Chaque secret peut aussi venir d'un
# fichier : NOM_FILE=/chemin (convention des secrets Docker).

# Port publié sur l'hôte par docker-compose.yml.
SENTINEL_PORT=8090

# Jeton de service du Hub : ouvre l'API (état, tâches, réveils), jamais les
# comptes ni les réglages. Génère-le :  openssl rand -hex 24
SENTINEL_HUB_TOKEN=

# Adresse publique annoncée aux agents (vide = celle de la requête d'enrôlement).
SENTINEL_PUBLIC_URL=

# Commande libre : 1 pour l'autoriser. Même à 1, elle exige le rôle
# administrateur et une confirmation récente.
SENTINEL_ALLOW_EXEC=0

# Plafonds : machines, remontées d'agent par minute et par IP.
SENTINEL_MAX_MACHINES=5000
SENTINEL_INGEST_MINUTE=240

# Seuils des alertes (une alerte par machine et par règle, résolue d'elle-même
# quand la cause disparaît). Hors ligne : minutes sans remontée. Correctifs :
# jours d'attente d'une mise à jour de sécurité. Disque : pourcentage rempli.
# Risque : score sur 100.
SENTINEL_ALERT_OFFLINE_MINUTES=15
SENTINEL_ALERT_PATCH_DAYS=7
SENTINEL_ALERT_DISK_PERCENT=90
SENTINEL_ALERT_RISK=70

# Réveil réseau en émission directe depuis le serveur : 1 SEULEMENT si le
# conteneur tourne sur le réseau de l'hôte. Sinon Sentinel passe par un agent
# relais du même segment (recommandé).
SENTINEL_HOST_NET=0

# Prise en main à distance (MeshCentral). URL vide = désactivé.
SENTINEL_MESH_URL=
SENTINEL_MESH_USER=
SENTINEL_MESH_LOGIN_KEY=
SENTINEL_MESH_EMBED=0

# ─── Comptes (socle) ───
# La clé maîtresse vient du secret Docker secrets/socle_cle, hors du volume de
# données : docker-compose.yml la passe en SOCLE_CLE_FILE (README, « Installation
# seule »), et un secret vide arrête le démarrage.
# 1 seulement sur un réseau de confiance sans HTTPS : pas de clé d'accès,
# mode dégradé affiché partout.
SOCLE_HTTP=0
SOCLE_PROXYS=
SOCLE_ORIGINES=
# Vide : Sentinel en tire un au premier démarrage et l'écrit dans ses journaux.
SOCLE_JETON_INSTALLATION=

# Alertes de sécurité par courriel (facultatif). Sans relais, elles restent
# visibles dans la page Sécurité.
SOCLE_URL_PUBLIQUE=
SOCLE_SMTP_HOTE=
SOCLE_SMTP_PORT=
SOCLE_SMTP_SECURITE=tls
SOCLE_SMTP_UTILISATEUR=
SOCLE_SMTP_MOTDEPASSE=
SOCLE_SMTP_DE=

# SYNAPSE (facultatif) : la mémoire du parc.
SYNAPSE_URL=
SYNAPSE_JETON=
